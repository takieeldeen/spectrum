{
  "expo": {
    "name": "Spectrum",
    "slug": "spectrum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F6F6",
      "imageWidth": 170,
      "dark": {
        "backgroundColor": "#111E23"
      }
    },
    "ios": {
      "bundleIdentifier": "com.spectrum.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "The app requires access to the local network so it can access wifi network"
      },
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "package": "com.spectrum.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F6F6",
          "image": "./assets/images/splash-screen.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#111E23"
          }
        }
      ],
      [
        "react-native-wifi-reborn",
        {
          "fineLocationPermission": true
        }
      ],
      "expo-status-bar",
      "@react-native-vector-icons/lucide",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "ar"]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b357a3e-53fc-474c-a43e-2c89c05157bf"
      }
    },
    "owner": "takie_eldeen"
  }
}
